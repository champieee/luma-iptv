<Window x:Class="LumaIPTV.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Title="Luma · IPTV Player" Width="1320" Height="860" MinWidth="820" MinHeight="620" Background="#0A101C" FontFamily="Segoe UI" Foreground="#F0F5FD" WindowStartupLocation="CenterScreen" SizeChanged="WindowResized" PreviewKeyDown="WindowKeyDown">
 <Grid Background="#0A101C">
  <Grid x:Name="LoginScreen" Margin="44">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="440"/></Grid.ColumnDefinitions>
   <Grid x:Name="WelcomePanel" Margin="0,0,48,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal"><Border Background="#67E8CB" CornerRadius="12" Width="42" Height="42"><TextBlock Text="L" Foreground="#09271F" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="luma" FontSize="28" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Row="1" VerticalAlignment="Center">
     <TextBlock Text="YOUR WORLD. ON SCREEN." Foreground="#67E8CB" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,24"/>
     <TextBlock Text="One place.&#10;Endless viewing." FontSize="52" FontWeight="SemiBold" LineHeight="60"/>
     <TextBlock Text="Live moments, movie nights, and your next favorite series. Bring them all together." Foreground="{StaticResource Muted}" FontSize="17" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left" Margin="0,24,0,32" LineHeight="27"/>
     <Border CornerRadius="16" Padding="24" BorderBrush="#29443E" BorderThickness="1">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#183D38" Offset="0"/><GradientStop Color="#162238" Offset="1"/></LinearGradientBrush></Border.Background>
      <StackPanel><TextBlock Text="A little less browsing.&#10;A little more watching." FontSize="22" FontWeight="SemiBold"/><TextBlock Text="LIVE TV     /     MOVIES     /     SERIES" Foreground="#9AC6BD" FontSize="11" Margin="0,24,0,0"/></StackPanel>
     </Border>
    </StackPanel>
    <TextBlock Grid.Row="2" Text="Made for your big screen. And every window size." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
   </Grid>
   <Border Grid.Column="1" CornerRadius="20" Background="#141D2D" BorderBrush="#26344A" BorderThickness="1" Padding="32" VerticalAlignment="Center">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="680">
     <StackPanel>
      <TextBlock Text="Welcome to Luma" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="Connect your Xtream account to get started." Foreground="{StaticResource Muted}" Margin="0,10,0,28" TextWrapping="Wrap"/>
      <TextBlock Text="Server URL" Margin="0,0,0,8"/><TextBox x:Name="ServerBox" AutomationProperties.Name="Server URL" ToolTip="Your provider's server URL, including http:// or https:// and the port if needed"/>
      <TextBlock Text="https://your-provider.com:8080" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,20"/>
      <TextBlock Text="Username" Margin="0,0,0,8"/><TextBox x:Name="UsernameBox" AutomationProperties.Name="Username" Margin="0,0,0,20"/>
      <TextBlock Text="Password" Margin="0,0,0,8"/><PasswordBox x:Name="PasswordInput" AutomationProperties.Name="Password" Margin="0,0,0,20"/>
      <CheckBox x:Name="RememberBox" Content="Remember this account on this PC" Foreground="#BBC8DC" Margin="0,0,0,20"/>
      <TextBlock x:Name="LoginError" Foreground="#FFABAB" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
      <Button x:Name="ConnectButton" Content="Connect account  →" Style="{StaticResource Primary}" Click="ConnectClick" IsDefault="True"/>
      <Button x:Name="DemoButton" Content="Explore the demo" Click="DemoClick" Margin="0,10,0,0" Background="Transparent"/>
      <TextBlock Text="Credentials are sent only to your provider. Remembered accounts are encrypted with your Windows user account. HTTP providers use an unencrypted connection." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,22,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <Grid x:Name="AppScreen" Visibility="Collapsed">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SideColumn" Width="186"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="Sidebar" Background="#101827" BorderBrush="#202D40" BorderThickness="0,0,1,0" Padding="18,26,18,22">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <StackPanel Orientation="Horizontal" Margin="6,0,0,40"><Border Width="32" Height="32" Background="#67E8CB" CornerRadius="9"><TextBlock Text="L" Foreground="#08271F" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="BrandText" Text="luma" FontSize="25" FontWeight="SemiBold" Margin="10,-3,0,0"/></StackPanel>
      <TextBlock x:Name="LibraryLabel" Text="YOUR LIBRARY" FontSize="10" Foreground="#71849F" Margin="12,0,0,14"/>
      <Button x:Name="LiveNav" Content="◉   Live TV" Tag="live" Click="NavClick" Background="#234038" Foreground="#67E8CB" HorizontalContentAlignment="Left" Margin="0,0,0,8" ToolTip="Live TV"/>
      <Button x:Name="MoviesNav" Content="▣   Movies" Tag="movie" Click="NavClick" Background="Transparent" Margin="0,0,0,8" ToolTip="Movies"/>
      <Button x:Name="SeriesNav" Content="▤   Series" Tag="series" Click="NavClick" Background="Transparent" Margin="0,0,0,28" ToolTip="Series"/>
      <Button x:Name="FavoritesNav" Content="♡   Favorites" Click="FavoritesClick" Background="Transparent" ToolTip="Show favorites in the current library"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom">
      <Border x:Name="AccountBadge" Background="#19253A" CornerRadius="10" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="CONNECTED" FontSize="9" Foreground="#67E8CB"/><TextBlock x:Name="AccountText" Text="Your account" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel></Border>
      <Button x:Name="SignOutButton" Content="↪   Sign out" Click="SignOutClick" Background="Transparent" ToolTip="Sign out and erase saved login"/>
     </StackPanel>
     <Grid/>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" x:Name="MainArea" Margin="28,26,28,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="Header" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="MAKE YOURSELF AT HOME" Foreground="#71849F" FontSize="10"/><TextBlock x:Name="PageTitle" Text="Live TV" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="DemoBadge" Visibility="Collapsed" Background="#3A3122" CornerRadius="7" Padding="10,6" Margin="0,0,12,0"><TextBlock Text="DEMO LIBRARY" Foreground="#EBD397" FontSize="10"/></Border><Button Content="↻" FontSize="20" Padding="12,5" Click="RefreshClick" ToolTip="Refresh library" AutomationProperties.Name="Refresh library"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1" x:Name="Filters" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" TextChanged="SearchChanged" ToolTip="Search by name" AutomationProperties.Name="Search library"/><TextBlock Text="Search your library…" x:Name="SearchHint" Foreground="#71849F" IsHitTestVisible="False" Margin="13,10,0,0"/><ComboBox x:Name="CategoryBox" Grid.Column="2" DisplayMemberPath="Name" SelectionChanged="CategoryChanged" AutomationProperties.Name="Category"/></Grid>
    <Grid Grid.Row="2" x:Name="ContentGrid">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="330"/><ColumnDefinition x:Name="ContentGap" Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="LibraryPanel" Background="#121B2B" CornerRadius="14" BorderBrush="#243147" BorderThickness="1" Padding="12">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <DockPanel Margin="7,3,7,14"><Button x:Name="BackButton" Content="←" Visibility="Collapsed" Click="BackClick" Padding="9,3" Margin="0,0,9,0" ToolTip="Back to series"/><TextBlock x:Name="ResultCount" Text="YOUR CHANNELS" Foreground="#91A6C1" FontSize="10" VerticalAlignment="Center"/></DockPanel>
       <ListBox Grid.Row="1" x:Name="ChannelList" SelectionChanged="ChannelSelected" AutomationProperties.Name="Library items">
        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#24344B" CornerRadius="9" Width="38" Height="38" VerticalAlignment="Center"><TextBlock Text="{Binding Monogram}" Foreground="#99E8D6" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,2,0,2"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Subtitle}" Foreground="#91A6C1" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock x:Name="EmptyLibrary" Grid.Row="1" Text="No matches.&#10;Try another search or category." Visibility="Collapsed" Foreground="#91A6C1" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="16"/>
      </Grid>
     </Border>
     <Grid Grid.Column="2" x:Name="PlayerColumn"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="InfoRow" Height="210"/></Grid.RowDefinitions>
      <Border Background="#050A12" CornerRadius="14" BorderBrush="#243147" BorderThickness="1">
       <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="VideoArea" Margin="1">
         <vlc:VideoView x:Name="Video" Visibility="Collapsed"/>
         <Border x:Name="PlayerPlaceholder" CornerRadius="14,14,0,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#17352F" Offset="0"/><GradientStop Color="#101D31" Offset="0.55"/><GradientStop Color="#0D1322" Offset="1"/></LinearGradientBrush></Border.Background><Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="22"><StackPanel Width="360" VerticalAlignment="Center" HorizontalAlignment="Center"><Border CornerRadius="32" Background="#27483F" Width="64" Height="64" HorizontalAlignment="Center"><TextBlock Text="▶" FontSize="25" Foreground="#8CF5D9" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0"/></Border><TextBlock x:Name="PlaceholderTitle" Text="Your next watch starts here" FontSize="22" FontWeight="SemiBold" Margin="0,22,0,0" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="PlaceholderDetail" Text="Choose something from your library and press play." Foreground="#9FB3C7" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" MaxWidth="340"/></StackPanel></Viewbox></Border>
        </Grid>
        <Border Grid.Row="1" Background="#172134" CornerRadius="0,0,14,14" Padding="14,10">
         <StackPanel><Slider x:Name="SeekSlider" Minimum="0" Maximum="1000" Value="0" IsEnabled="False" PreviewMouseLeftButtonUp="SeekReleased" PreviewKeyUp="SeekKeyUp" AutomationProperties.Name="Playback position" ToolTip="Seek position" Margin="0,0,0,10"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <Button x:Name="PlayPauseButton" Content="▶" Click="PlayPauseClick" Padding="12,6" Style="{StaticResource Primary}" ToolTip="Play or pause" AutomationProperties.Name="Play or pause"/>
           <Button Grid.Column="1" Content="■" Click="StopClick" Padding="10,6" Margin="6,0,0,0" ToolTip="Stop" AutomationProperties.Name="Stop"/>
           <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="TimeText" Text="READY" Foreground="#9FB3C7" FontSize="10" VerticalAlignment="Center"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80" Width="65" Margin="12,0,0,0" ValueChanged="VolumeChanged" ToolTip="Volume" AutomationProperties.Name="Volume"/></StackPanel>
           <Button Grid.Column="3" Content="⛶" Click="FullscreenClick" Padding="10,4" FontSize="19" ToolTip="Fullscreen (F11). Escape to exit." AutomationProperties.Name="Toggle fullscreen"/>
          </Grid>
         </StackPanel>
        </Border>
       </Grid>
      </Border>
      <Grid Grid.Row="1" x:Name="InfoPanel" Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="NowTitle" Text="Pick your perfect watch" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowSubtitle" Text="Your television, on your terms." Foreground="#91A6C1" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button x:Name="FavoriteButton" Grid.Column="1" Content="♡" IsEnabled="False" Click="FavoriteClick" Padding="12,5" FontSize="22" ToolTip="Toggle favorite" AutomationProperties.Name="Toggle favorite"/></Grid>
       <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,10"><TextBlock Text="UP NEXT" Foreground="#67E8CB" FontSize="10" VerticalAlignment="Center"/><ComboBox x:Name="FormatBox" Width="100" Margin="16,0,0,0" SelectedIndex="0" ToolTip="If a live stream does not play, try the other format and press play again" AutomationProperties.Name="Live stream format"><ComboBoxItem Content="MPEG-TS"/><ComboBoxItem Content="HLS"/></ComboBox></StackPanel>
       <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="GuideText" Text="Select a channel to see its program guide." Foreground="#91A6C1" FontSize="12" TextWrapping="Wrap" LineHeight="20"/></ScrollViewer>
      </Grid>
     </Grid>
    </Grid>
    <TextBlock Grid.Row="3" x:Name="StatusText" Text="Ready" Foreground="#91A6C1" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
   </Grid>
  </Grid>
 </Grid>
</Window>
